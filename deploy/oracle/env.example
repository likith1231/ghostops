# Copy to .env in the repo root (git-ignored) and fill in.

# Claude API key: powers the diagnostic, patch and validation agents.
ANTHROPIC_API_KEY=
# Optional: model for the agents (default claude-opus-5-5).
CLAUDE_MODEL=claude-opus-5-5

# GitHub token so GhostOps can push fix branches and open PRs
# (fine-grained token on this repo: Contents + Pull requests, read and write).
GITHUB_TOKEN=
GITHUB_REPO=likith1231/ghostops

# Optional. Defaults to <public-ip>.sslip.io
BASE_DOMAIN=
